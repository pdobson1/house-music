# Public URL of the site, used in verification emails
BASE_URL=http://localhost:3000
PORT=3000
# SMTP connection for sending verification emails, e.g.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# Without it (dev only) the verification link is printed to the console and shown on screen.
SMTP_URL=
MAIL_FROM="House Music <hello@example.com>"
# Where the SQLite file lives
DB_PATH=./data/house-music.db
# Set to 1 when running behind a reverse proxy (Render, Fly, nginx...)
TRUST_PROXY=
