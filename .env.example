# Local development needs none of these: data goes in ./data and
# verification links are printed to the console and shown on screen.

PORT=3000
# Public URL of the site, used in email links. Set automatically on Render.
BASE_URL=http://localhost:3000

# Database. Leave DATABASE_URL empty to use a local file at DB_PATH.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
DB_PATH=./data/house-music.db

# Email: a Brevo API key, or an SMTP connection string. One is required in production.
BREVO_API_KEY=
SMTP_URL=
MAIL_FROM="House Music <hello@example.com>"

# Set to 1 when running behind a reverse proxy (Render, nginx...)
TRUST_PROXY=
