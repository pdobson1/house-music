<a class="card" href="/parties/<%= p.id %>">
  <div class="sleeve" style="--h: <%= hue(p.album + p.artist) %>" aria-hidden="true"><span class="disc"></span></div>
  <div class="card-body">
    <p class="when"><%= fmtDate(p.starts_at) %></p>
    <h3><%= p.album %></h3>
    <p class="artist"><%= p.artist %></p>
    <p class="meta">🍸 <%= p.cocktail %></p>
    <p class="meta"><%= p.city %> · hosted by <%= p.host_name %></p>
    <p class="spots <%= p.going >= p.capacity ? 'full' : '' %>">
      <%= p.going >= p.capacity ? 'Full' : `${p.capacity - p.going} of ${p.capacity} spots left` %>
    </p>
  </div>
</a>
