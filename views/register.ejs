<%- include('partials/head') %>
<form class="panel" method="post" action="/register">
  <h1>Sign up</h1>
  <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
  <label>Your name <input name="name" value="<%= values.name || '' %>" maxlength="60" autocomplete="name" required></label>
  <label>Email <input type="email" name="email" value="<%= values.email || '' %>" autocomplete="email" required></label>
  <label>Password <input type="password" name="password" minlength="8" autocomplete="new-password" required>
    <small>At least 8 characters.</small></label>
  <button class="btn">Create account</button>
  <p class="alt">Already have an account? <a href="/login">Sign in</a></p>
</form>
<%- include('partials/foot') %>
