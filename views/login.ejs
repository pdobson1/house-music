<%- include('partials/head') %>
<form class="panel" method="post" action="/login">
  <h1>Sign in</h1>
  <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
  <% if (unverified) { %>
    <p class="notice" role="alert">You still need to confirm your email. We’ve just sent a new link to <strong><%= unverified %></strong>.</p>
    <% if (devLink) { %><p class="dev">Dev mode, no email is being sent: <a href="<%= devLink %>">confirm now</a></p><% } %>
  <% } %>
  <input type="hidden" name="next" value="<%= next %>">
  <label>Email <input type="email" name="email" value="<%= email %>" autocomplete="email" required></label>
  <label>Password <input type="password" name="password" autocomplete="current-password" required></label>
  <button class="btn">Sign in</button>
  <p class="alt">New here? <a href="/register">Sign up</a></p>
</form>
<%- include('partials/foot') %>
