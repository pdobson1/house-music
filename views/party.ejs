<%- include('partials/head') %>
<article class="party">
  <div class="sleeve big" style="--h: <%= hue(party.album + party.artist) %>" aria-hidden="true"><span class="disc"></span></div>
  <div>
    <p class="when"><%= fmtDate(party.starts_at) %><% if (past) { %> · finished<% } %></p>
    <h1><%= party.album %></h1>
    <p class="artist"><%= party.artist %> · on repeat all evening</p>
    <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
    <dl>
      <dt>Cocktail</dt><dd>🍸 <%= party.cocktail %></dd>
      <dt>Host</dt><dd><%= party.host_name %></dd>
      <dt>Where</dt>
      <dd><%= party.city %>
        <% if (party.address) { %><br><strong><%= party.address %></strong>
        <% } else { %><br><small>The address is shared once the host approves you.</small><% } %>
      </dd>
      <dt>Spots</dt><dd><%= party.going %> of <%= party.capacity %> taken</dd>
    </dl>
    <% if (party.notes) { %><p class="notes"><%= party.notes %></p><% } %>

    <% if (isHost) { %>
      <p class="notice">You’re hosting this one.</p>
      <details class="confirm">
        <summary class="btn danger">Cancel party</summary>
        <form method="post" action="/parties/<%= party.id %>/cancel">
          <p>This removes the party and emails everyone who asked to come.</p>
          <button class="btn danger">Yes, cancel it</button>
        </form>
      </details>
    <% } else if (myStatus === 'approved') { %>
      <p class="notice">You’re on the list. See you there.</p>
      <form method="post" action="/parties/<%= party.id %>/leave"><button class="btn ghost">Give up my spot</button></form>
    <% } else if (myStatus === 'pending') { %>
      <p class="notice">Request sent. <%= party.host_name %> will get back to you, and we’ll email you when they do.</p>
      <form method="post" action="/parties/<%= party.id %>/leave"><button class="btn ghost">Withdraw request</button></form>
    <% } else if (myStatus === 'declined') { %>
      <p class="notice">The host isn’t able to offer you a spot at this one.</p>
    <% } else if (past) { %>
      <p class="notice">This party has already happened.</p>
    <% } else if (party.going >= party.capacity) { %>
      <p class="notice">This party is full.</p>
    <% } else if (user) { %>
      <form method="post" action="/parties/<%= party.id %>/rsvp"><button class="btn">Ask for a spot</button></form>
      <p><small>The host approves each guest.</small></p>
    <% } else { %>
      <a class="btn" href="/login?next=/parties/<%= party.id %>">Sign in to ask for a spot</a>
    <% } %>

    <% if (isHost) { %>
      <h2>Requests waiting for you</h2>
      <% if (!requests.length) { %><p class="empty">No requests waiting.</p><% } else { %>
        <ul class="people">
          <% for (const g of requests) { %>
            <li><span><%= g.name %></span>
              <form method="post" action="/parties/<%= party.id %>/guests/<%= g.id %>/approve"><button class="btn small">Approve</button></form>
              <form method="post" action="/parties/<%= party.id %>/guests/<%= g.id %>/decline"><button class="btn small ghost">Decline</button></form>
            </li>
          <% } %>
        </ul>
      <% } %>
    <% } %>
    <% if (isHost || myStatus === 'approved') { %>
      <h2>Guest list</h2>
      <% if (!guests.length) { %><p class="empty">Nobody is confirmed yet.</p><% } else { %>
        <ul class="people">
          <% for (const g of guests) { %>
            <li><span><%= g.name %></span>
              <% if (isHost) { %><form method="post" action="/parties/<%= party.id %>/guests/<%= g.id %>/decline"><button class="btn small ghost">Remove</button></form><% } %>
            </li>
          <% } %>
        </ul>
      <% } %>
    <% } %>
  </div>
</article>
<%- include('partials/foot') %>
